# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- secrets ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- configuration ---
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# --- logging ---
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console    # console (dev) | json (cloud)

# --- prompt observability (optional; wire later) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
